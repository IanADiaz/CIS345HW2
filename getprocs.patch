diff --git a/getprocs.c b/getprocs.c
new file mode 100644
index 0000000..977a3ed
--- /dev/null
+++ b/getprocs.c
@@ -0,0 +1,10 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+int 
+main(void) 
+{
+	printf(1, "Processes running: %d\n", getprocs());
+	exit();
+}
diff --git a/proc.c b/proc.c
index 806b1b1..9036f19 100644
--- a/proc.c
+++ b/proc.c
@@ -532,3 +532,17 @@ procdump(void)
     cprintf("\n");
   }
 }
+
+int
+countprocs(void) {
+	struct proc *p;
+	int count = 0;
+
+	acquire(&ptable.lock);
+	for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+		if(p->state == RUNNABLE || p->state == RUNNING)
+			count++;
+	}
+	release(&ptable.lock);
+	return count;
+}
